{
  "name": "fishery-forecast-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Offshore Fishery Forecast Platform — offline map, OpenAPI contract, and mock front-end for integrated fishery forecasting.",
  "license": "Apache-2.0",
  "author": "HuangXin-erniu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuangXin-erniu/fishery-forecast-platform.git"
  },
  "homepage": "https://github.com/HuangXin-erniu/fishery-forecast-platform#readme",
  "bugs": {
    "url": "https://github.com/HuangXin-erniu/fishery-forecast-platform/issues"
  },
  "keywords": [
    "fishery",
    "forecast",
    "offshore",
    "react",
    "openlayers",
    "openapi",
    "mock",
    "research-platform"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "openapi-typescript configs/openapi.json -o src/api-types.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run tests/unit.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ol": "10.11.0",
    "msw": "3.0.6"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.1",
    "openapi-typescript": "7.13.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
